services:
  wg-easy:
    image: {{ wireguard_image }}
    container_name: {{ wireguard_container_name }}
    environment:
      - WG_HOST={{ wireguard_host }}
{% if wireguard_password_hash | length > 0 %}
      - PASSWORD_HASH={{ wireguard_password_hash }}
{% endif %}
      - WG_PORT={{ wireguard_port }}
      - WG_DEFAULT_ADDRESS={{ wireguard_default_address }}
      - WG_DEFAULT_DNS={{ wireguard_default_dns }}
    volumes:
      - ./etc_wireguard:/etc/wireguard
    ports:
      - "{{ wireguard_port }}:51820/udp"
      - "{{ wireguard_web_port }}:51821/tcp"
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    sysctls:
      - net.ipv4.conf.all.src_valid_mark=1
      - net.ipv4.ip_forward=1
    restart: {{ wireguard_restart_policy }}
